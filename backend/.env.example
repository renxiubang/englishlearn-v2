# ── 模型服务 ────────────────────────────────────────────
MLLM_BASE_URL=http://127.0.0.1:8000/v1
MLLM_MODEL=gemma-4-e4b-it-4bit
MLLM_API_KEY=omlx-local
MLLM_TIMEOUT=120
# provider 兼容开关：local=本地 Gemma；dashscope=百炼 Qwen-Omni（开发期临时替换）
MLLM_PROVIDER=local
# 切百炼 Qwen-Omni 示例（需百炼 API Key）：
# MLLM_PROVIDER=dashscope
# MLLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MLLM_MODEL=qwen3-omni-flash
# MLLM_API_KEY=sk-xxx

TTS_BASE_URL=http://127.0.0.1:8880
TTS_VOICE=af_heart
TTS_SPEED=1.1

# ── 数据库 ──────────────────────────────────────────────
DB_URL=mysql+asyncmy://app:CHANGE_ME@127.0.0.1:3306/english_learn

# ── 存储与服务 ──────────────────────────────────────────
STORAGE_DIR=./storage
API_PORT=8080
CORS_ORIGINS=["http://localhost:5173"]
