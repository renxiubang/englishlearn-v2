# ── 模型服务 ────────────────────────────────────────────
MLLM_BASE_URL=http://127.0.0.1:8000/v1
MLLM_MODEL=gemma-4-e4b-it-4bit
MLLM_API_KEY=omlx-local
MLLM_TIMEOUT=120
# provider 兼容开关：local=本地 Gemma；dashscope=百炼 Qwen-Omni（开发期临时替换）
MLLM_PROVIDER=local
# 切百炼 Qwen-Omni 示例（需百炼 API Key）：
# MLLM_PROVIDER=dashscope
# MLLM_BASE_URL=https://llm-psr5sae1ttmdwvez.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# MLLM_MODEL=qwen3-omni-flash
# MLLM_API_KEY=sk-ws-H.EIEXRIL.nzSf.MEUCIQDc0C9vC9sP9uTPCQTzIR4KbxhKicCM1EicEkef5dkvxgIganmv_5gX0TSQaZqPGcLO1fik3M4J6xGxU-fBtJ0zERU

TTS_BASE_URL=http://127.0.0.1:8880
TTS_VOICE=af_heart
TTS_SPEED=1.1

# ── 数据库 ──────────────────────────────────────────────
DB_URL=mysql+asyncmy://app:CHANGE_ME@127.0.0.1:3306/english_learn

# ── 存储与服务 ──────────────────────────────────────────
STORAGE_DIR=./storage
API_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ── 管理后台 ──────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME

# ── 日志 ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
# time=按日期每天午夜切分；size=按大小切分（单文件 LOG_MAX_BYTES）
LOG_ROTATION=time
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
